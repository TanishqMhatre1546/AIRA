# Application execution environment (development, production, or test)
ENVIRONMENT=development

# Logging output level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Permitted CORS origins as a JSON list of URL strings
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Google Gemini API key for embeddings and generation
GEMINI_API_KEY=

# Google Gemini chat model name
CHAT_MODEL=gemini-2.5-flash

# Google Gemini embedding model name
EMBEDDING_MODEL=gemini-embedding-001

# Master flag to enable or disable LLM generation calls
LLM_ENABLED=true

# Maximum allowed character length for user symptom queries
MAX_INPUT_CHARS=500

# Number of relevant guideline chunks to retrieve
TOP_K=5

# Minimum cosine similarity threshold for vector retrieval
RETRIEVAL_MIN_COSINE=0.65

# Maximum allowed requests per minute per client IP address
RATE_LIMIT_PER_MINUTE=20

# Request timeout limit in seconds for LLM API calls
LLM_TIMEOUT_SECONDS=12

# Path to the data directory containing curated guidelines and indexes
DATA_DIR=./data

# Security flag: allow serving guidelines not yet marked clinically verified
ALLOW_UNVERIFIED_CONTENT=false

# Clinical review sign-off status flag
CLINICAL_REVIEW_DONE=false

# Name or identifier of clinician who completed clinical review
CLINICAL_REVIEW_BY=

# Date when clinical review sign-off was performed (YYYY-MM-DD)
CLINICAL_REVIEW_DATE=
