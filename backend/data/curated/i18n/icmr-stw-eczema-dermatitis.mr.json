      "flags": []
    },
    "dccbb755c5ec": {
      "item_id": "dccbb755c5ec",
      "source_hash": "d1757d40852f",
      "text": "मोठ्या प्रमाणावर पसरलेला आजार ज्यासाठी फोटोथेरपी किंवा संपूर्ण शरीरासाठीच्या उपचारांची गरज आहे",
