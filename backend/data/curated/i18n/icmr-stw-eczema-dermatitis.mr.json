      "flags": []
    },
    "d93bf33debe8": {
      "item_id": "d93bf33debe8",
      "source_hash": "01eb72f28943",
      "text": "संसर्गाच्या लक्षणांसह एक्झिमा: पू, पिवळी खपली किंवा वाढती लाली",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "b11435640f07": {
      "item_id": "b11435640f07",
      "source_hash": "f363e60a3af8",
      "text": "लहान मुलामध्ये एक्झिमा, विशेषतः जर तो चेहऱ्यावर, त्वचेच्या घड्यांवर असेल किंवा खाजेमुळे झोपमोड होत असेल",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "e1f716c7bc0f": {
      "item_id": "e1f716c7bc0f",
      "source_hash": "5428b88e43c1",
      "text": "प्राथमिक उपचार पातळीवर उपचारांना प्रतिसाद न देणारा तीव्र एक्झिमा",
