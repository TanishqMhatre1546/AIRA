    "27c159090b62": {
      "item_id": "27c159090b62",
      "source_hash": "045ce2b5fade",
      "text": "एक्झिमामध्ये पू येणे, पिवळी खपली धरणे किंवा त्वचा गरम पडणे, हे दुय्यम जिवाणू संसर्गाचे लक्षण आहे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "34cd6dc77436": {
      "item_id": "34cd6dc77436",
      "source_hash": "34d8043de2e6",
      "text": "त्वचेवर मोठ्या प्रमाणावर फोड येणे किंवा त्वचा सोलवटून निघणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "e4b574dd231f": {
      "item_id": "e4b574dd231f",
      "source_hash": "2fd7f9ca5cda",
      "text": "तापाबरोबर एक्झिमाची लक्षणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "72f26e816f76": {
      "item_id": "72f26e816f76",
      "source_hash": "d8b026647a22",
      "text": "शरीराच्या मोठ्या भागावर पसरलेला गंभीर एक्झिमा जो कोणत्याही उपचाराला दाद देत नाही",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "f497748b44fa": {
      "item_id": "f497748b44fa",
      "source_hash": "8349b53b8655",
      "text": "आंघोळीनंतर लगेचच जेव्हा त्वचा थोडी ओलसर असेल तेव्हा मॉइश्चरायझर लावा, एक्झिमा नियंत्रणात ठेवण्यासाठी ही सर्वात महत्त्वाची पायरी आहे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "07e289aab8ec": {
      "item_id": "07e289aab8ec",
      "source_hash": "50363d97149a",
      "text": "दिवसातून केवळ एकदाच नव्हे तर अनेक वेळा मॉइश्चरायझर लावा",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "31c8d461a179": {
      "item_id": "31c8d461a179",
      "source_hash": "d5db629cdb43",
      "text": "सौम्य साबण आणि सामान्य तापमानाच्या पाण्याने रोज आंघोळ करा; गरम पाणी वापरणे टाळा",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "94c1d931f64c": {
      "item_id": "94c1d931f64c",
      "source_hash": "e2a07195aff3",
      "text": "खाजवल्यामुळे त्वचेला होणारे नुकसान टाळण्यासाठी हाताची नखे लहान ठेवा",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "d7b45d3352b3": {
      "item_id": "d7b45d3352b3",
      "source_hash": "01d8cbb8c645",
      "text": "खाजवणे टाळा, खाजवल्याने एक्झिमा बळावतो आणि संसर्गाचा धोका वाढतो",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "53f6d6f71a9b": {
      "item_id": "53f6d6f71a9b",
      "source_hash": "892e5bb52749",
      "text": "कारणे (ट्रिगर्स) ओळखा आणि टाळा: विशिष्ट साबण, डिटर्जंट, कपडे, वनस्पती किंवा अन्नपदार्थ ज्यामुळे त्वचा अधिक बिघडते",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "434e7f480330": {
      "item_id": "434e7f480330",
      "source_hash": "49f9f121089c",
      "text": "त्वचेची जळजळ कमी करण्यासाठी सैल, सुती कपडे घाला",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "7c70ed99e4f9": {
      "item_id": "7c70ed99e4f9",
      "source_hash": "fb214fab4c96",
      "text": "शक्य असल्यास उच्च-जोखीम असलेल्या कामांमधील संपर्क टाळा: शेतीकाम, बांधकाम, हेअरड्रेसिंगमध्ये त्वचेचा वारंवार त्रासदायक घटकांशी संपर्क येतो",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "b021588544ca": {
      "item_id": "b021588544ca",
      "source_hash": "77eb3b341df1",
      "text": "कॉन्टॅक्ट डर्मेटायटिससाठी, मूळ कारण ओळखा आणि ते दूर करा (उदा. विशिष्ट साबण, धातू किंवा वनस्पती)",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "b53d3a0c8693": {
      "item_id": "b53d3a0c8693",
      "source_hash": "7616f8985e93",
      "text": "अ‍ॅटोपिक डर्मेटायटिस अनेकदा हिवाळ्यात वाढतो, थंड हवामानात जास्त मॉइश्चरायझर लावणे महत्त्वाचे आहे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "b2d6a57a939e": {
      "item_id": "b2d6a57a939e",
      "source_hash": "e3b085def8b4",
      "text": "डॉक्टरांच्या सल्ल्याशिवाय स्वतःहून कोणतीही स्टेरॉईड क्रीम वापरू नका, विशेषतः चेहऱ्यावर किंवा त्वचेच्या घड्यांवर",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "3afed764fcf3": {
      "item_id": "3afed764fcf3",
      "source_hash": "f575ec8c3d99",
      "text": "लाली, खपली किंवा खाज असलेला कोणताही नवीन पुरळ जो मूलभूत काळजी घेऊनही 1 आठवड्यात सुधारत नाही",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "80383d6bdd03": {
      "item_id": "80383d6bdd03",
      "source_hash": "b3a10af6f12f",
      "text": "चेहऱ्यावर, पापण्यांवर किंवा गुप्तांगांवर एक्झिमा",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "fa10053a842f": {
      "item_id": "fa10053a842f",
      "source_hash": "75731ad5517b",
      "text": "कामाच्या ठिकाणी एखाद्या ऍलर्जीकारक घटकामुळे पुरळ उठल्याचा संशय असणे",
