      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "c751275f0c88": {
      "item_id": "c751275f0c88",
      "source_hash": "091d20eb8296",
      "text": "एक्झिमा जो त्याच भागांवर पुन्हा पुन्हा होतो",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "afdaf5a357f6": {
      "item_id": "afdaf5a357f6",
      "source_hash": "fbb8f2d447cb",
      "text": "दीर्घकाळ एक्झिमा राहिल्यामुळे ठिकठिकाणी त्वचा जाड किंवा चामड्यासारखी कडक होणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
