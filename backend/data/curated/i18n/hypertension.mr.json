      "flags": []
    },
    "592378af5858": {
      "item_id": "592378af5858",
      "source_hash": "69a29ee63838",
      "text": "वेदना ज्या जबडा, मान, हात, खांदे किंवा पाठीमध्ये पसरत आहेत",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
