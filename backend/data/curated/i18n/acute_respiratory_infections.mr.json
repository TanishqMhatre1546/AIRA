      "flags": []
    },
    "d155894ed7c7": {
      "item_id": "d155894ed7c7",
      "source_hash": "e95b65592c92",
      "text": "निरोगी प्रौढ व्यक्तीमध्ये बहुतांश हलकी सर्दी आणि खोकला औषधांशिवाय 7 ते 10 दिवसांत बरा होतो",
      "back_translation": "",
      "status": "reviewed",
