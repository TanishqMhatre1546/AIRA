      "flags": []
    },
    "c83ae21d672a": {
      "item_id": "c83ae21d672a",
      "source_hash": "0a85c66f5e93",
      "text": "श्वास घेताना पोट छातीच्या विरुद्ध दिशेने हलणे (पॅराडॉक्सिकल श्वासोच्छ्वास), जे श्वासाच्या तीव्र त्रासाचे लक्षण आहे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "53b762e07069": {
      "item_id": "53b762e07069",
      "source_hash": "545d47ed5e62",
      "text": "ओठ, बोटांची टोके किंवा चेहऱ्यावर निळसर किंवा जांभळा रंग येणे (सायनोसिस), जे अत्यंत कमी ऑक्सिजनचे लक्षण आहे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "0c5ddfd9c26b": {
      "item_id": "0c5ddfd9c26b",
      "source_hash": "9875474355fd",
      "text": "धाप लागल्यामुळे एका वेळी फक्त काहीच शब्द बोलता येणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "521df0007e03": {
      "item_id": "521df0007e03",
      "source_hash": "3f92aa32fb87",
      "text": "50 किंवा त्यापेक्षा कमी वयाच्या व्यक्तीमध्ये ऑक्सिजनचे प्रमाण 92% किंवा त्याहून कमी, किंवा 50 वर्षांपेक्षा जास्त वयाच्या व्यक्तीमध्ये 90% पेक्षा कमी असणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "09d31c60077f": {
      "item_id": "09d31c60077f",
      "source_hash": "024ce74b67a7",
      "text": "श्वासाच्या त्रासासोबत गोंधळलेली मानसिक अवस्था किंवा असंबद्धता असणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "3324d144d6c4": {
      "item_id": "3324d144d6c4",
      "source_hash": "f55a86b2939d",
      "text": "खोकल्यातून रक्त पडणे, जे टीबी किंवा इतर गंभीर आजाराचे लक्षण असू शकते",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "fa79295ad5d0": {
      "item_id": "fa79295ad5d0",
      "source_hash": "5bd25eb78440",
      "text": "श्वास घेण्यास त्रास आणि सोबत अतिशय कमी रक्तदाब (लो BP)",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "eccdd10f3b51": {
      "item_id": "eccdd10f3b51",
      "source_hash": "f44fd2feeb30",
      "text": "श्वासाच्या त्रासासोबत शरीराचे तापमान अतिशय जास्त किंवा खूप कमी असणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "ea7ed1d47448": {
      "item_id": "ea7ed1d47448",
      "source_hash": "82d14b15392b",
      "text": "श्वासाच्या त्रासासह संशयित फ्लू, विशेषतः अलीकडील प्रवासाचा इतिहास असल्यास किंवा फ्लूची साथ असल्यास",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "924ff0474dd3": {
      "item_id": "924ff0474dd3",
      "source_hash": "a1bbb7a7aaf3",
      "text": "संसर्ग पसरू नये म्हणून विश्रांती घ्या आणि इतरांपासून सुरक्षित अंतर ठेवून घरी राहा",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "217ed4072412": {
      "item_id": "217ed4072412",
      "source_hash": "f48645da5534",
      "text": "पुरेसे द्रवपदार्थ प्या, जसे पाणी, गरम सूप, मध आणि आल्यासह कोमट पाणी, नारळ पाणी",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "855ec7233869": {
      "item_id": "855ec7233869",
      "source_hash": "efd74dac5d87",
      "text": "ताप किंवा अंगदुखीसाठी पॅकवरील सूचनेनुसार पॅरासिटामॉल घेता येऊ शकते",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "8e57ba4f5a30": {
      "item_id": "8e57ba4f5a30",
      "source_hash": "dc4f6c4a9089",
      "text": "वाफ घेतल्याने नाक आणि छातीतील कफ किंवा दाटणे मोकळे होण्यास मदत होते",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "b6190b4154fe": {
      "item_id": "b6190b4154fe",
      "source_hash": "7fcf73b2f0fb",
      "text": "कोमट मिठाच्या पाण्याच्या गुळण्या केल्याने घशातील खवखव आणि त्रास कमी होतो",
