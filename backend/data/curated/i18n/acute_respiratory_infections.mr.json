      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "7b8abbd5222d": {
      "item_id": "7b8abbd5222d",
      "source_hash": "d892c73e1537",
      "text": "धूम्रपान टाळा आणि धूर किंवा धुळीच्या संपर्कात येणे टाळा",
