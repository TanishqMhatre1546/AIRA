      "flags": []
    },
    "7fb4d1e84565": {
      "item_id": "7fb4d1e84565",
      "source_hash": "34990f745296",
      "text": "कोणत्याही सुधाराशिवाय 10 ते 14 दिवसांपेक्षा जास्त काळ टिकणारा खोकला",
