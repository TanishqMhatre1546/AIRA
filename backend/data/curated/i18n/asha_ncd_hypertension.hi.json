  "translations": {
    "11647faecfd9": {
      "item_id": "11647faecfd9",
      "source_hash": "34916c784e73",
      "text": "सीने के बीच में 30 मिनट से अधिक समय तक रहने वाला दर्द, दबाव या भारीपन",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
