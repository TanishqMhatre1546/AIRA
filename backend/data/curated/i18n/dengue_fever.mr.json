      "flags": []
    },
    "240f966588fe": {
      "item_id": "240f966588fe",
      "source_hash": "c861ef0456eb",
      "text": "शरीरात पाणी साठणे जे पोटावर सूज किंवा फुफ्फुसाभोवती पाणी झाल्यामुळे श्वासाच्या त्रासाच्या स्वरूपात दिसते",
      "back_translation": "",
      "status": "reviewed",
