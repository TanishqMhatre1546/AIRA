      "flags": []
    },
    "cf262dec8dcc": {
      "item_id": "cf262dec8dcc",
      "source_hash": "0da6e3c040c2",
      "text": "स्टेरॉईडयुक्त क्रीम दीर्घकाळ वापरल्याचा संशय किंवा इतिहास, यामुळे बुरशीजन्य संसर्ग खूप वाढू शकतो आणि त्यावर उपचार करणे अत्यंत कठीण होऊ शकते",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "3b2b161b3fb9": {
      "item_id": "3b2b161b3fb9",
      "source_hash": "edbbbe4a89f9",
      "text": "साध्या साबणाने आणि सामान्य तापमानाच्या पाण्याने रोज आंघोळ करा",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "4bc2d77ea6cb": {
      "item_id": "4bc2d77ea6cb",
      "source_hash": "b16a1bf931a4",
      "text": "आंघोळीनंतर त्वचा व्यवस्थित कोरडी करा, विशेषतः पायांच्या बोटांमधील जागा आणि त्वचेच्या घड्या",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "e94c6acd35ad": {
      "item_id": "e94c6acd35ad",
      "source_hash": "dc6fcfa812f3",
      "text": "कपडे गरम पाण्यात वेगळे धुवा आणि ते उन्हात उलटे करून वाळवा",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "0218004e3037": {
      "item_id": "0218004e3037",
      "source_hash": "3f709b6f202f",
      "text": "टॉवेल, कपडे किंवा अंतर्वस्त्रे इतरांसोबत शेअर करू नका",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "7bf6f2ed734b": {
      "item_id": "7bf6f2ed734b",
      "source_hash": "a1b91d648328",
      "text": "कपडे न धुता पुन्हा वापरू नका",
