      "flags": []
    },
    "8b3ee2fdd4e2": {
      "item_id": "8b3ee2fdd4e2",
      "source_hash": "5bf23c12d84d",
      "text": "गरोदरपणात किंवा यकृत, मूत्रपिंड अथवा हृदयविकार असलेल्या व्यक्तीमध्ये संसर्ग",
