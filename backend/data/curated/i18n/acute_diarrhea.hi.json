      "flags": []
    },
    "df9c50007437": {
      "item_id": "df9c50007437",
      "source_hash": "81b8460ebf4b",
      "text": "बिल्कुल पानी पीने में असमर्थ होना या बहुत कठिनाई से पीना",
      "back_translation": "",
      "status": "reviewed",
