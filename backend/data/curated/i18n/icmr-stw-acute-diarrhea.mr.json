      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "6ca8a4bafb6d": {
      "item_id": "6ca8a4bafb6d",
      "source_hash": "9b3f4be764df",
      "text": "वारंवार उलट्या होणे ज्यामुळे पाणी किंवा द्रव पोटात टिकत नाही",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "489fc1c8c5c6": {
      "item_id": "489fc1c8c5c6",
      "source_hash": "55830207234b",
      "text": "उपचारानंतर 2 दिवसांनंतरही विष्ठेत रक्त येणे आणि सुधारणा न होणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "30a7a3e77882": {
      "item_id": "30a7a3e77882",
      "source_hash": "009afe538a45",
      "text": "तीव्र तापाबरोबर जुलाब आणि प्रकृती खालावणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "9ba8c203969d": {
      "item_id": "9ba8c203969d",
      "source_hash": "db9626342130",
      "text": "तीव्र कुपोषण किंवा एचआयव्ही असलेल्या व्यक्तीमध्ये जुलाब",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
