      "flags": []
    },
    "1beb4c230d79": {
      "item_id": "1beb4c230d79",
      "source_hash": "b3b59f84fb5e",
      "text": "डिहायड्रेशन किंवा गंभीर आजाराच्या लक्षणांसह 14 दिवसांपेक्षा जास्त काळ टिकणारा जुलाब",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "bf465c932433": {
      "item_id": "bf465c932433",
      "source_hash": "72e433d95a3f",
      "text": "त्वरित ओरल रिहायड्रेशन सुरू करा, घरी जुलाबाचा सर्वात महत्त्वाचा उपचार म्हणजे शरीरातील कमी झालेले पाणी आणि क्षारांची भरपाई करणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "819791f33421": {
      "item_id": "819791f33421",
      "source_hash": "a74811566e67",
      "text": "कोणत्याही फार्मसी किंवा सरकारी आरोग्य केंद्रात उपलब्ध असणारे ORS (ओआरएस) पाकीट वापरा: पाकिटावर दर्शविलेल्या स्वच्छ पाण्याच्या प्रमाणात (सहसा 200 ml किंवा 1 litre) एक पाकीट विरघळवा आणि वारंवार थोडे थोडे प्या",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "43fa1f21dd53": {
      "item_id": "43fa1f21dd53",
      "source_hash": "225e536d4f1a",
      "text": "जर ORS पाकीट उपलब्ध नसेल, तर तात्पुरता घरगुती पर्याय वापरला जाऊ शकतो: एका ग्लास स्वच्छ पाण्यात चिमूटभर मीठ आणि थोडी साखर घाला, चांगले ढवळा आणि वारंवार थोडे थोडे प्या",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "eedb1c657e4d": {
      "item_id": "eedb1c657e4d",
      "source_hash": "0d67332fe9ae",
      "text": "इतर उपयुक्त घरगुती द्रवपदार्थ: मिठाचे भाताचे पाणी (पेज), मिठाची ताक किंवा लस्सी, भाजीपाल्याचे सूप, साखर नसलेला ताजा फळांचा रस, नारळ पाणी",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "8d2b36608a02": {
      "item_id": "8d2b36608a02",
      "source_hash": "86003a371c19",
      "text": "प्रत्येक पातळ जुलाबानंतर अतिरिक्त द्रवपदार्थ प्या, प्रौढांनी प्रत्येक वेळेनंतर किमान 200 ml प्यावे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "283e1a3455f6": {
      "item_id": "283e1a3455f6",
      "source_hash": "124be0dba254",
      "text": "जुलाब वाढवणारे अयोग्य द्रवपदार्थ: कार्बोनेटेड शीतपेये (कोल्ड ड्रिंक्स/सोडा), बाजारातील गोड फळांचे रस, गोड चहा किंवा कॉफी",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "26f73d38b93b": {
      "item_id": "26f73d38b93b",
      "source_hash": "1f87c79e6ad5",
      "text": "जेवणे सुरू ठेवा, उपवास करू नका. हलका, सहज पचणारा आहार घ्या. आजारपणात तेलकट किंवा तिखट अन्न टाळा",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "b34188382c50": {
      "item_id": "b34188382c50",
      "source_hash": "b045df6c8381",
      "text": "जेवणापूर्वी, शौचालयाचा वापर केल्यानंतर आणि विष्ठेचा संपर्क आल्यानंतर साबण आणि पाण्याने हात स्वच्छ धुवा",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "2e08e8e1c851": {
      "item_id": "2e08e8e1c851",
      "source_hash": "8658c0848700",
      "text": "फक्त स्वच्छ, सुरक्षित पिण्याचे पाणी वापरा, सुरक्षिततेची खात्री नसल्यास पाणी उकळून प्या",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "361bc25e01e9": {
      "item_id": "361bc25e01e9",
      "source_hash": "a49b5bfaeca8",
      "text": "तातडीने वैद्यकीय मदत घ्या जर: खूप वेळा पातळ संडास होत असेल, वारंवार उलट्या होत असतील, पाणी पिता येत नसेल, ताप आला असेल, शौचात रक्त दिसले, किंवा 5 दिवसांत प्रकृतीत सुधारणा होत नसेल",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "e941b3753f9e": {
      "item_id": "e941b3753f9e",
      "source_hash": "4990059ffe36",
      "text": "घरी काळजी घेऊनही 5 दिवसांनंतर जुलाबात सुधारणा न होणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
