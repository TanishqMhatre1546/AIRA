    "bc043dc471f7": {
      "item_id": "bc043dc471f7",
      "source_hash": "208a4b0978a4",
      "text": "संशयित कॉलरा: अचानक खूप मोठ्या प्रमाणात पांढऱ्या पातळ पाण्यासमान जुलाब (तांदळाच्या पाण्यासारखा संडास) सुरू होणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "4139ba17e4d0": {
      "item_id": "4139ba17e4d0",
      "source_hash": "0541d75c867c",
      "text": "जुलाब म्हणजे दिवसातून 3 किंवा अधिक वेळा पातळ किंवा पाण्यासारखा संडास होणे. तीव्र जुलाब 14 दिवसांपेक्षा कमी काळ टिकतो. 14 दिवसांपेक्षा जास्त काळ राहणारा जुलाब म्हणजे दीर्घकालीन जुलाब. विष्ठेत रक्त असणे म्हणजे आव किंवा आमांशाचे लक्षण आहे.",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "e74c91e62130": {
