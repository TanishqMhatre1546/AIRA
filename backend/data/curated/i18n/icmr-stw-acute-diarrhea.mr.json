      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "79335f1d7eb6": {
      "item_id": "79335f1d7eb6",
      "source_hash": "7833cac6194e",
      "text": "जुलाबासोबत खूप उलट्या होणे ज्यामुळे पाणी किंवा द्रव पोटात टिकत नाही",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "f6d3a507c693": {
      "item_id": "f6d3a507c693",
      "source_hash": "a40ea1b5a73d",
      "text": "मध्यम डिहायड्रेशनची लक्षणे: अस्वस्थता, डोळे खोल जाणे, खूप तहान लागणे, त्वचेचा चिमटा हळू पूर्ववत होणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "80f1649cf640": {
      "item_id": "80f1649cf640",
      "source_hash": "8d4112ae0af8",
      "text": "जुलाबासोबत ताप असणे",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "cd10ce4eec65": {
      "item_id": "cd10ce4eec65",
      "source_hash": "9f2b1a969d5a",
      "text": "मधुमेह, हृदयरोग किंवा मूत्रपिंडाचा (किडनी) आजार असलेल्या व्यक्तीमध्ये जुलाब",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
