      "flags": []
    },
    "2d68abef7474": {
      "item_id": "2d68abef7474",
      "source_hash": "69de529a3bb5",
      "text": "कोणत्याही सुधाराशिवाय वारंवार पातळ संडास होणे",
      "back_translation": "",
      "status": "reviewed",
