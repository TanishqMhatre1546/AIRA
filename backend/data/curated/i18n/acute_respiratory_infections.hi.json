      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
    "9ed87612c215": {
      "item_id": "9ed87612c215",
      "source_hash": "6dbc46a53049",
      "text": "सीने में दर्द जो सांस लेने या खांसने पर बढ़ जाता है",
      "back_translation": "",
      "status": "reviewed",
      "reviewer": "Dr. R. Sharma (MD, General Medicine)",
      "reviewed_on": "2026-10-23",
      "flags": []
    },
