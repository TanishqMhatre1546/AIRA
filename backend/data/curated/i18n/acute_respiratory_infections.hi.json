      "flags": []
    },
    "fe0d05aace0d": {
      "item_id": "fe0d05aace0d",
      "source_hash": "a93223fad868",
      "text": "बुखार जो लगातार बना रहे, तेज हो, या ठंड (कंपकंपी) के साथ आए",
      "back_translation": "",
      "status": "reviewed",
