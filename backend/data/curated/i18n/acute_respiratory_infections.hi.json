      "flags": []
    },
    "3960d4c40670": {
      "item_id": "3960d4c40670",
      "source_hash": "e06054390447",
      "text": "रात में पसीना आना, बिना कारण वजन कम होना, या लंबे समय तक थकान के साथ खांसी, ये टीबी के संकेत हो सकते हैं",
