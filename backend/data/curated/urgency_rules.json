          "cannot open mouth",
          "unable to open mouth",
          "trismus",
          "grey membrane in throat",
          "gray membrane in throat",
          "neck swelling"
        ],
        "requires_all": []
      },
      "negatable": true,
      "response": "Inability to swallow saliva, stridor (noisy high-pitched breathing), muffled voice, or a grey throat membrane indicate dangerous airway infections like epiglottitis or peritonsillar abscess. Go to a hospital emergency room immediately.",
      "review_status": "source_backed"
    },
